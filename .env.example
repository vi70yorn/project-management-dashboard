# ==========================================================
# PostgreSQL Database Configuration
# ==========================================================
# In Cloud Production (Render, Railway), set DATABASE_URL from Neon.tech or Supabase:
# DATABASE_URL=postgresql://user:password@ep-sample-pool.neon.tech/project_management?sslmode=require

# For Local Development (if not using DATABASE_URL):
PGHOST=localhost
PGPORT=5432
PGDATABASE=project_management
PGUSER=postgres
PGPASSWORD=your_password

# Port for backend server (Render automatically sets PORT)
PORT=5000

# ==========================================================
# JWT Authentication & AES-256 Payload Encryption
# ==========================================================
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=7d

# 32-byte hex string (64 characters)
API_ENCRYPTION_KEY=
VITE_API_ENCRYPTION_KEY=

# Optional: Gemini API Key if using AI features
# GEMINI_API_KEY=
